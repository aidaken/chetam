# Chetam environment

## Required
DATABASE_URL=postgresql://...
NEON_AI_GATEWAY_BASE_URL=https://br-....aws.neon.tech
NEON_AI_GATEWAY_TOKEN=nt_live_...
LLM_MODEL=gpt-5-mini
DEMO_USER_ID=11111111-1111-1111-1111-111111111111

## Exa (gift search)
EXA_API_KEY=

## AgentMail (emails after approval only)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_USERNAME=chetam
EMAIL_ENABLED=false
EMAIL_ALLOWLIST=you@example.com

## Calendar / Drive providers (seeded by default)
CALENDAR_PROVIDER=seeded
DRIVE_PROVIDER=seeded
# CALENDAR_PROVIDER=executor  # not implemented yet
# DRIVE_PROVIDER=executor

## Optional
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
